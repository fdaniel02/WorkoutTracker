@page "/type/{Id:int}"
@rendermode RenderModes.InteractiveServerNoPrerender
@inject IDbContextFactory<AppDbContext> DbFactory
@inject Clock Clock
@inject RoutineStateStore Routines

<PageTitle>@type?.Name</PageTitle>

<main class="page">
    <a class="back" href="">‹ All workouts</a>

    @if (type is null)
    {
        <p class="muted">@(loaded ? "Workout type not found." : "Loading…")</p>
    }
    else
    {
        <h1>@type.Name</h1>
        <div class="muted">@total workout@(total == 1 ? "" : "s") total</div>

        <Heatmap Grid="grid" Today="today" Done="done" />

        <div class="spacer"></div>
        @if (routineInProgress is { } routine)
        {
            <p class="blocked">Finish or abandon <a href="routine/@routine.Id/run">@routine.Name</a> first.</p>
        }
        else
        {
            <a class="btn primary big" href="workout/@Id" style="text-align:center;text-decoration:none;display:block">Start workout</a>
        }
    }
</main>

@code {
    const int Weeks = 16;

    [Parameter] public int Id { get; set; }

    WorkoutType? type;
    bool loaded;
    int total;
    DateOnly today;
    HeatmapGrid grid = null!;
    HashSet<DateOnly> done = [];
    Routine? routineInProgress;

    protected override async Task OnParametersSetAsync()
    {
        using var activity = Telemetry.ActivitySource.StartActivity("Load WorkoutTypePage");
        activity?.SetTag("workouttracker.workout_type_id", Id);
        await using var db = await DbFactory.CreateDbContextAsync();
        type = await db.WorkoutTypes.FindAsync(Id);
        loaded = true;
        if (type is null) return;

        today = Clock.Today;
        grid = new HeatmapGrid(today, Weeks);

        total = await db.Workouts.CountAsync(w => w.WorkoutTypeId == Id);
        var times = await db.Workouts.StartTimesSince(Id, Clock.StartOfDayUtc(grid.Start)).ToListAsync();
        done = times.Select(Clock.ToLocalDate).ToHashSet();

        if (await Routines.LoadAsync() is { } routine)
            routineInProgress = await db.Routines.FindAsync(routine.RoutineId);
    }
}

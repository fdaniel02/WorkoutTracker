@page "/"
@rendermode RenderModes.InteractiveServerNoPrerender
@inject IDbContextFactory<AppDbContext> DbFactory
@inject Clock Clock
@inject WorkoutStateStore Store
@inject RoutineStateStore Routines
@inject IJSRuntime JS

<PageTitle>@ViewName</PageTitle>

<main class="page">
    <div class="page-header">
        <h1>@ViewName</h1>
        @if (view == HomeView.Workouts)
        {
            <button class="icon-btn add" aria-label="Add workout type" title="Add workout type" @onclick="Open">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
            </button>
            <button class="icon-btn filter @(filter == TypeFilter.HideRoutineOnly ? "active" : "")" aria-label="@FilterLabel" title="@FilterLabel"
                    aria-pressed="@(filter == TypeFilter.HideRoutineOnly ? "true" : "false")" @onclick="ToggleFilterAsync">
                <svg viewBox="0 0 24 24" fill="@(filter == TypeFilter.HideRoutineOnly ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" />
                </svg>
            </button>
        }
        <button class="icon-btn sort" aria-label="@OrderLabel" title="@OrderLabel" @onclick="ToggleOrderAsync">
            @if (order == TypeOrder.Name)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 4v16M2 16l4 4 4-4M14 10l3-7 3 7M15.3 7.5h3.4M14 14h6l-6 6h6" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            }
        </button>
    </div>

    <div class="tabs" role="tablist">
        <button role="tab" class="tab @(view == HomeView.Workouts ? "active" : "")" aria-selected="@(view == HomeView.Workouts ? "true" : "false")"
                @onclick="() => ShowAsync(HomeView.Workouts)">Workouts</button>
        <button role="tab" class="tab @(view == HomeView.Routines ? "active" : "")" aria-selected="@(view == HomeView.Routines ? "true" : "false")"
                @onclick="() => ShowAsync(HomeView.Routines)">Routines</button>
    </div>

    @if (types is null || routines is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        @if (routineInProgress is { } r && routines.FirstOrDefault(x => x.Id == r.RoutineId) is { } currentRoutine)
        {
            <a class="list-item continue" href="routine/@currentRoutine.Id/run">
                <span>Continue @currentRoutine.Name</span>
                <span class="muted ago">@r.DoneItemIds.Count done</span>
            </a>
        }
        else if (inProgress is { } p && types.FirstOrDefault(t => t.Id == p.TypeId) is { } current)
        {
            <a class="list-item continue" href="workout/@current.Id">
                <span>Continue @current.Name</span>
                <span class="muted ago">@p.Reps rep@(p.Reps == 1 ? "" : "s")</span>
            </a>
        }
        <div class="list">
            @foreach (var e in Shown)
            {
                <a class="list-item" href="@(view == HomeView.Workouts ? "type" : "routine")/@e.Id">
                    <span class="@(e.Favorite ? "favorite" : null)">@e.Name</span>
                    @if (e.LastUtc is { } last)
                    {
                        <span class="muted ago">@Ago(last)</span>
                    }
                </a>
            }
        </div>
        @if (Shown.Count == 0)
        {
            <p class="muted">@EmptyMessage</p>
        }
    }

</main>

@if (showDialog)
{
    <div class="overlay" @onclick="Close">
        <form class="dialog" @onclick:stopPropagation="true" @onsubmit="AddAsync">
            <h2>New workout type</h2>
            <input @bind="newName" @bind:event="oninput" placeholder="e.g. Push ups" maxlength="100" autofocus />
            @if (error is not null)
            {
                <div class="error">@error</div>
            }
            <div class="row">
                <button type="button" class="btn" @onclick="Close">Cancel</button>
                <button type="submit" class="btn primary">Add</button>
            </div>
        </form>
    </div>
}

@code {
    enum HomeView { Workouts, Routines }

    List<ListEntry>? types;
    List<ListEntry>? routines;
    HomeView view;
    RoutineState? routineInProgress;

    string ViewName => view == HomeView.Workouts ? "Workouts" : "Routines";

    List<ListEntry> Shown => view == HomeView.Workouts ? TypeOrdering.Filter(types!, filter) : routines!;

    string EmptyMessage => view switch
    {
        HomeView.Routines => "No routines yet.",
        _ when types!.Count > 0 => "All workouts are hidden. Tap the filter to show them.",
        _ => "No workout types yet. Tap + to add your first one."
    };
    string newName = "";
    string? error;
    bool showDialog;

    void Open() { newName = ""; error = null; showDialog = true; }
    void Close() => showDialog = false;

    WorkoutState? inProgress;
    TypeOrder order;
    TypeFilter filter;

    string FilterLabel => filter == TypeFilter.HideRoutineOnly
        ? "Hiding unstarred workouts that are in a routine. Tap to show all."
        : "Showing all workouts. Tap to hide unstarred workouts that are in a routine.";

    string OrderLabel => order == TypeOrder.Name
        ? "Sorted by name. Tap to sort by last workout."
        : "Sorted by last workout, oldest first. Tap to sort by name.";

    protected override async Task OnInitializedAsync()
    {
        using var activity = Telemetry.ActivitySource.StartActivity("Load Home");
        inProgress = await Store.LoadAsync();
        routineInProgress = await Routines.LoadAsync();
        order = TypeOrdering.Parse(await JS.InvokeAsync<string?>("typeOrder.load"));
        filter = TypeOrdering.ParseFilter(await JS.InvokeAsync<string?>("typeFilter.load"));
        view = Enum.TryParse<HomeView>(await JS.InvokeAsync<string?>("homeView.load"), out var saved) && Enum.IsDefined(saved)
            ? saved : HomeView.Workouts;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var typeRows = await db.WorkoutTypes
            .Select(t => new ListEntry(t.Id, t.Name, t.Workouts.Max(w => (DateTime?)w.StartedAtUtc),
                t.IsFavorite, db.RoutineItems.Any(i => i.WorkoutTypeId == t.Id)))
            .ToListAsync();
        var routineRows = await db.Routines
            .Select(r => new ListEntry(r.Id, r.Name, r.Runs.Max(x => (DateTime?)x.StartedAtUtc)))
            .ToListAsync();
        types = TypeOrdering.Sort(typeRows, order);
        routines = TypeOrdering.Sort(routineRows, order);
    }

    async Task ToggleOrderAsync()
    {
        order = order == TypeOrder.Name ? TypeOrder.LastDone : TypeOrder.Name;
        if (types is not null) types = TypeOrdering.Sort(types, order);
        if (routines is not null) routines = TypeOrdering.Sort(routines, order);
        await JS.InvokeVoidAsync("typeOrder.save", order.ToString());
    }

    async Task ToggleFilterAsync()
    {
        filter = filter == TypeFilter.HideRoutineOnly ? TypeFilter.All : TypeFilter.HideRoutineOnly;
        await JS.InvokeVoidAsync("typeFilter.save", filter.ToString());
    }

    async Task ShowAsync(HomeView shown)
    {
        view = shown;
        await JS.InvokeVoidAsync("homeView.save", shown.ToString());
    }

    string Ago(DateTime utc)
    {
        var days = Clock.Today.DayNumber - Clock.ToLocalDate(utc).DayNumber;
        return days switch
        {
            <= 0 => "today",
            1 => "1 day ago",
            _ => $"{days} days ago"
        };
    }

    async Task AddAsync()
    {
        error = null;
        var name = newName.Trim();
        if (name.Length == 0) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.TryAddWorkoutTypeAsync(name))
        {
            error = "That workout type already exists.";
            return;
        }
        showDialog = false;
        await LoadAsync();
    }
}

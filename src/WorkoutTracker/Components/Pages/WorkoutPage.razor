@page "/workout/{Id:int}"
@rendermode RenderModes.InteractiveServerNoPrerender
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorkoutStateStore Store
@inject RoutineStateStore Routines
@inject WorkoutMetrics Metrics
@inject TimeProvider Time

<PageTitle>@type?.Name</PageTitle>

<main class="page">
    @if (type is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <h1 class="workout-title">@type.Name</h1>
        @if (item is { } i && RoutineTarget.Format(i.ProposedSets, i.ProposedReps) is { } target)
        {
            <div class="muted workout-target">@target</div>
        }

        <ElapsedTimer State="state" />

        <div class="reps">
            <div class="muted reps-label">@RepsHeading</div>
            <div class="rep-circles" role="img" aria-label="@RepsLabel">
                @for (var rep = 1; rep <= state.Reps; rep++)
                {
                    <span class="rep-circle">@rep</span>
                }
                @if (state.Started && !state.Resting)
                {
                    <span class="rep-circle current">@(state.Reps + 1)</span>
                }
            </div>
        </div>
        @if (state.Resting)
        {
            <div class="rest-label">Rest</div>
        }
        else
        {
            <button class="btn primary big" @onclick="AddRepAsync" disabled="@(!state.Started)">+1</button>
        }

        <div class="spacer"></div>

        @if (state.Resting)
        {
            <button class="btn warn" @onclick="EndRestAsync">Start</button>
        }
        else
        {
            <button class="btn warn" @onclick="ToggleTimerAsync">@ToggleLabel</button>
        }
        @if (confirmAbandon)
        {
            @* Only while confirming: a click handler on <main> would make every tap on the page its own trace. *@
            <div class="dismiss-layer" @onclick="CancelAbandon"></div>
        }
        <div class="row">
            <button class="btn primary wide" @onclick="FinishAsync" disabled="@saving">Finish</button>
            <button class="btn danger @(confirmAbandon ? "confirm" : "")" @onclick="AbandonAsync">
                @(confirmAbandon ? "Are you sure?" : "Abandon")
            </button>
        </div>
    }
</main>

@code {
    [Parameter] public int Id { get; set; }
    // The routine item this workout is started from, on the routine in progress.
    [SupplyParameterFromQuery] public int? Item { get; set; }

    WorkoutState state = new();
    // True once the saved state belongs to this page, so Finish/Abandon don't clear another type's workout.
    bool saved;
    bool confirmAbandon;
    bool saving;
    WorkoutType? type;
    RoutineState? routine;
    RoutineItem? item;

    DateTime UtcNow => Time.GetUtcNow().UtcDateTime;

    string RepsHeading => item?.ProposedSets is { } sets ? $"Sets {state.Reps} / {sets}" : "Repetitions";

    string ToggleLabel => state switch
    {
        { Started: false } => "Start",
        { Running: true } => "Pause",
        _ => "Resume"
    };

    string RepsLabel => state.Reps == 1 ? "1 repetition" : $"{state.Reps} repetitions";

    protected override async Task OnInitializedAsync()
    {
        using var activity = Telemetry.ActivitySource.StartActivity("Load WorkoutPage");
        activity?.SetTag("workouttracker.workout_type_id", Id);
        await using var db = await DbFactory.CreateDbContextAsync();
        type = await db.WorkoutTypes.FindAsync(Id);
        if (type is null)
        {
            Nav.NavigateTo("");
            return;
        }

        routine = await Routines.LoadAsync();
        var restored = await Store.LoadAsync();
        if (restored?.TypeId == Id && (Item is null || restored.RoutineItemId == Item))
        {
            state = restored;
            saved = true;
        }
        else
        {
            // A workout of another type stays saved until this one is started.
            state = new WorkoutState { TypeId = Id, StartedUtc = UtcNow, RoutineItemId = Item };
        }

        if (state.RoutineItemId is { } itemId && routine is not null)
            item = await db.RoutineItems.SingleOrDefaultAsync(i =>
                i.Id == itemId && i.RoutineId == routine.RoutineId && i.WorkoutTypeId == Id);
        if (item is null)
        {
            state.RoutineItemId = null;
            // Only workouts of the routine in progress can be started until it's finished or abandoned.
            if (routine is not null && !saved)
                Nav.NavigateTo($"routine/{routine.RoutineId}/run");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("wakeLock.on");
    }

    async Task SaveAsync()
    {
        await Store.SaveAsync(state);
        saved = true;
    }

    async Task ToggleTimerAsync()
    {
        state.ToggleTimer(UtcNow);
        await SaveAsync();
    }

    async Task AddRepAsync()
    {
        state.AddRep(UtcNow);
        await SaveAsync();
    }

    async Task EndRestAsync()
    {
        state.EndRest(UtcNow);
        await SaveAsync();
    }

    // `saving` stays set after a successful save, so a tap before the navigation completes is ignored too.
    async Task FinishAsync()
    {
        if (saving) return;
        saving = true;
        state.Stop(UtcNow);
        var typeName = type!.Name;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var workout = new Workout
            {
                ClientId = state.Id,
                WorkoutTypeId = Id,
                StartedAtUtc = state.StartedUtc,
                FinishedAtUtc = UtcNow
            };
            await db.SaveWorkoutAsync(workout, typeName, state.Reps);
        }
        Metrics.WorkoutSaved(typeName);
        if (saved) await Store.ClearAsync();
        if (item is not null && routine is not null)
        {
            routine.DoneItemIds.Add(item.Id);
            await Routines.SaveAsync(routine);
        }
        Nav.NavigateTo(Exit ?? $"type/{Id}");
    }

    async Task AbandonAsync()
    {
        if (!confirmAbandon)
        {
            confirmAbandon = true;
            return;
        }
        if (saved) await Store.ClearAsync();
        Nav.NavigateTo(Exit ?? "");
    }

    string? Exit => item is null ? null : $"routine/{item.RoutineId}/run";

    void CancelAbandon() => confirmAbandon = false;

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("wakeLock.off");
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone, and it releases the wake lock together with the page.
        }
    }
}
